# Facebook Ad Publishing (required for "Publish to Facebook" in admin)
# Get these from Meta Business Suite / Developers: https://developers.facebook.com/
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_AD_ACCOUNT_ID=act_XXXXXXXX
FACEBOOK_PAGE_ID=

# Base URL of the frontend (used for ad landing links). No trailing slash.
FRONTEND_BASE_URL=https://your-frontend.run.app

# Stripe Checkout success/cancel URLs use the first comma-separated origin here (no trailing slash).
# Falls back to http://localhost:5173 if unset.
FRONTEND_ORIGIN=https://your-frontend.run.app

# Stripe (donations: Product + pay-what-you-want Checkout when campaign has stripe_product_id after approval)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Public base URL of THIS API (no trailing slash). Required for Facebook ad images: Meta must fetch
# /images/... over the internet. Local uploads store http://localhost:... — set this to your deployed
# API (same bucket) so slideshow thumbnails rewrite to a public URL, or omit and the ad uses Meta's placeholder image.
API_BASE_URL=https://your-api.run.app

# PostHog (public client key — returned by GET /config/analytics for the frontend)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Impact report: optional campaign fields (perception_shift, thumbs_up, etc.) are set via
# PATCH /data/campaigns/:id — see docs/impact-firestore-schema.md
# Meta ad metrics sync: POST /facebook/sync-insights (scheduler) or per-campaign sync-insights

# Klaviyo campaign report drips. The API runner sends flow-trigger events:
# - Unravel Campaign Launch Report
# - Unravel Campaign Mid Campaign Report
# - Unravel Campaign Recap Report
KLAVIYO_API_KEY=
KLAVIYO_REVISION=2024-10-15
# How many hours before campaign_starts_at the launch/pre-live report becomes eligible.
KLAVIYO_REPORT_LAUNCH_LEAD_HOURS=24
