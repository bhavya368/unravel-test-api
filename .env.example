# Facebook Ad Publishing (required for "Publish to Facebook" in admin)
# Get these from Meta Business Suite / Developers: https://developers.facebook.com/
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_AD_ACCOUNT_ID=act_XXXXXXXX
FACEBOOK_PAGE_ID=

# Base URL of the frontend (used for ad landing links). No trailing slash.
FRONTEND_BASE_URL=https://your-frontend.run.app

# Stripe Checkout success/cancel URLs use the first comma-separated origin here (no trailing slash).
# Falls back to http://localhost:5173 if unset.
FRONTEND_ORIGIN=https://your-frontend.run.app

# Stripe (donations: Product + pay-what-you-want Checkout when campaign has stripe_product_id after approval)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Public base URL of THIS API (no trailing slash). Required for Facebook ad images: Meta must fetch
# /images/... over the internet. Local uploads store http://localhost:... — set this to your deployed
# API (same bucket) so slideshow thumbnails rewrite to a public URL, or omit and the ad uses Meta's placeholder image.
API_BASE_URL=https://your-api.run.app

# PostHog (public client key — returned by GET /config/analytics for the frontend)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# UE-188: share-ref attribution window in days (default 7). Exposed via GET /config/attribution.
# Client persists ?ref= for this window; completed backs carrying share_ref attribute to the sharer.
SHARE_ATTRIBUTION_WINDOW_DAYS=7

# Langfuse LLM observability (Vertex Gemini: moderation, bias wheel, UUTS, image gen)
# Create keys in Langfuse project Settings → API Keys. Do not commit real keys.
# Hobby cloud is free: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com  |  US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional: production | staging | development (keeps test traces out of prod dashboards)
LANGFUSE_TRACING_ENVIRONMENT=development

# Impact report: optional campaign fields (perception_shift, thumbs_up, etc.) are set via
# PATCH /data/campaigns/:id — see docs/impact-firestore-schema.md
# Meta ad metrics sync: POST /facebook/sync-insights (scheduler) or per-campaign sync-insights

# UUTS pre-screening: async Vertex AI / Claude scoring on campaign submit.
# Off by default — set to true to connect/enable in an environment.
# Prompt source: ai_prompts/ucZnWEWd4t1f32H9f9Tj field `uuts_prescreen` (code rubric fallback if missing).
UUTS_PRESCREEN_ENABLED=false
# Optional Gemini model override; falls back to gemini-2.5-flash-lite.
GEMINI_MODEL_UUTS_PRESCREEN=gemini-2.5-flash-lite
# Claude Opus (Anthropic) for Admin model picker. Requires ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_UUTS_PRESCREEN=claude-opus-4-6
# When false (default), POST .../trust-report/publish is blocked — republish UI cannot hit live.
# Official Accepted decisions from the review console still publish the trust report.
UUTS_PUBLISH_LIVE_ENABLED=false
# Comma-separated internal reviewer names for the admin review-console dropdown.
UUTS_REVIEWERS=
# When false (default), POST /uuts-prescreen/run returns 503. Set true + Cloud Scheduler to enable.
UUTS_SCHEDULER_ENABLED=false
# Config: GET /uuts-prescreen/config  |  Scheduler: POST /uuts-prescreen/run (x-api-key)
# Firecrawl (optional): primary Sources-box URL scraper for UUTS external research.
# When set, fetchSourcesBoxEvidence uses Firecrawl first and falls back to legacy HTTP fetch.
# Free tier: https://www.firecrawl.dev/pricing — never commit the real key.
FIRECRAWL_API_KEY=

# Slack — campaign moderation uses SLACK_CHANNEL; UUTS pre-screen completion/failure uses SLACK_UUTS_CHANNEL.
# Invite the bot to both channels. Prefer channel IDs (C…) over names when possible.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=moderation
SLACK_UUTS_CHANNEL=uuts-prescreen

# Klaviyo campaign report drips. The API runner sends flow-trigger events:
# - Unravel Campaign Launch Report  (one event per backer; personal contribution/reach)
# - Unravel Campaign Mid Campaign Report  (one event per backer; reached_so_far, actions_so_far, percent_to_goal, …)
# - Unravel Campaign Recap Report  (one event per backer; final_reach, actions_sparked, total_spend, …)
# Shared / stage props: contribution_amount, projected_reach, pooled_amount, total_backers,
# campaign_name, campaignUrl, impactUrl, thumbnailUrl; mid also: reached_so_far, actions_so_far,
# percent_to_goal, collective_reach_so_far, perception_shift_mid; recap also: final_reach,
# actions_sparked, perception_shift, final_collective_reach, total_spend
#
# Runner: POST /campaign-report-drips/run  (x-api-key)
# Optional body/query: dryRun, limit, campaignId(s), stage(s)=launch|mid|recap,
# forceStage=launch|mid|recap (requires campaignId; ignores timing windows)
# Go-live: docs/klaviyo/LAUNCH.md
KLAVIYO_API_KEY=
KLAVIYO_REVISION=2024-10-15
# How many hours before campaign_starts_at the launch/pre-live report becomes eligible.
KLAVIYO_REPORT_LAUNCH_LEAD_HOURS=24
