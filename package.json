{
  "name": "unravel_api",
  "version": "1.0.0",
  "description": "Unravel API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "langfuse:setup-uuts": "ts-node -r dotenv/config --transpile-only scripts/langfuse/setupUutsEval.ts",
    "langfuse:seed-uuts": "ts-node -r dotenv/config --transpile-only scripts/langfuse/seedUutsDataset.ts",
    "langfuse:experiment-uuts": "ts-node -r dotenv/config --transpile-only scripts/langfuse/runUutsExperiment.ts",
    "emulator": "firebase emulators:start --only firestore",
    "emulator:export": "firebase emulators:start --only firestore --import ./local-dev/firestore-data --export-on-exit",
    "x:authorize": "ts-node -r dotenv/config --transpile-only scripts/x/authorize.ts",
    "x:verify": "ts-node -r dotenv/config --transpile-only scripts/x/verify.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fontsource/roboto": "^5.2.10",
    "@google-cloud/storage": "^7.18.0",
    "@google-cloud/vertexai": "^1.10.0",
    "@google/generative-ai": "^0.24.1",
    "@langfuse/client": "^5.9.1",
    "@langfuse/otel": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@resvg/resvg-js": "^2.6.2",
    "@slack/web-api": "^7.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "facebook-nodejs-business-sdk": "^19.0.0",
    "firebase-admin": "^13.6.0",
    "morgan": "^1.10.0",
    "pdf-parse": "^1.1.1",
    "posthog-node": "^5.39.4",
    "sanitize-html": "2.15.0",
    "stripe": "^20.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/sanitize-html": "^2.16.1",
    "firebase-tools": "^15.28.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
