rules_version = '2';

// LOCAL EMULATOR ONLY — never deploy this file.
// The API talks to Firestore through the Admin SDK, which bypasses rules entirely,
// so this exists only because firebase.json requires a rules file to start the
// Firestore emulator. Production rules are managed in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
